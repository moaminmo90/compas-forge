# ==========================================
# COMPAS Forge - Official .gitignore File
# ==========================================

# --- Rust Compiled Artifacts & Caches ---
/target/
Cargo.lock

# --- Python Compiled Files & Environments ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
env/
.env/

# --- Dynamic Compiled C Extensions (Local Builds) ---
python/compas_forge/_core.pyd
python/compas_forge/_core.*.pyd
python/compas_forge/_core.*.so

# --- CAD testing outputs & temporary file buffers ---
*_mesh.json
*cube.json
*_shell.json
*_column.json
*_beam.json
*.html
temp_preflight_model.json
temp_benchmark_mesh.json

# --- IDE, Editor, & OS System Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db